{
  "name": "fizzl-paypal-guard-mcp",
  "version": "0.1.1",
  "description": "PayPal's Agent Toolkit as an MCP server for Claude, Cursor and any MCP client, guarded by fizzl-paypal-guard: never more than is left of a payment, the owner's limits, and Approve/Deny on the owner's phone (Telegram, Fizzl wallet) or in the chat app above them.",
  "mcpName": "io.github.Fizzl13/paypal-guard",
