{
  "name": "presign-guard-solana-agent-kit",
  "version": "0.3.0",
  "description": "Spending limits and phone approvals for Solana Agent Kit agents: wraps the wallet so every transfer, swap and token action is checked by presign-guard (instructions decoded and simulated), kept to per-token limits, and sent to you for approval over the limit.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "main": "./index.js",
  "types": "./index.d.ts",
  "files": ["index.js", "index.d.ts", "README.md", "LICENSE"],
  "engines": { "node": ">=20" },
  "scripts": { "test": "node --test test/*.test.mjs" },
  "dependencies": { "presign-guard-wallet": "^0.26.0" },
  "peerDependencies": { "solana-agent-kit": ">=2.0.0", "@solana/web3.js": "^1.98.0", "zod": "^3.22.0 || ^4.0.0" },
  "devDependencies": { "solana-agent-kit": "^2.0.10", "@solana/web3.js": "^1.98.2", "zod": "^3.25.0" },
  "keywords": ["solana-agent-kit", "sendai", "solana", "x402", "agents", "wallet", "security", "presign", "spending-limits", "budget", "approvals", "telegram", "human-in-the-loop", "usdc", "jupiter"],
  "repository": { "type": "git", "url": "git+https://github.com/Fizzl13/x402-examples.git", "directory": "solana-agent-kit-guard" },
  "homepage": "https://github.com/Fizzl13/x402-examples/tree/main/solana-agent-kit-guard#readme",
  "license": "MIT"
}
