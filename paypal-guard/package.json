{
  "name": "fizzl-paypal-guard",
  "version": "0.3.0",
  "description": "Limits, checks and the owner's approval for AI agents that use PayPal's Agent Toolkit: refunds only for the customer in the conversation and never more than was paid, daily limits, an AI check that the action fits the request, and Approve/Deny on the owner's phone above the limits.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "main": "./index.js",
  "types": "./index.d.ts",
  "files": ["index.js", "index.d.ts", "src", "README.md", "LICENSE"],
  "engines": { "node": ">=20" },
  "scripts": { "test": "node --test test/*.test.mjs" },
  "keywords": ["paypal", "agent-toolkit", "ai-agents", "ai-sdk", "guardrails", "refunds", "disputes", "approval", "human-in-the-loop", "prompt-injection", "agentic-commerce", "telegram"],
  "repository": { "type": "git", "url": "git+https://github.com/Fizzl13/x402-examples.git", "directory": "paypal-guard" },
  "homepage": "https://github.com/Fizzl13/x402-examples/tree/main/paypal-guard#readme",
  "license": "MIT"
}
